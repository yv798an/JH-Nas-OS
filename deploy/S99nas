#!/bin/sh
# NAS 文件浏览器自启动脚本（适用于 Buildroot 的 BusyBox init 系统）
# 部署: 复制到开发板 /etc/init.d/S99nas 并加执行权限
#   cp deploy/S99nas /etc/init.d/S99nas
#   chmod +x /etc/init.d/S99nas
#
# 可通过环境变量覆盖默认值：
#   NAS_ROOT: 逗号分隔的存储挂载点（默认两个 U 盘）
#   NAS_ADDR: 监听地址（默认 :8080）

NAS_BIN="/usr/bin/nas-web"
NAS_ROOT="${NAS_ROOT:-/media/sda1,/media/sdb1}"
NAS_ADDR="${NAS_ADDR:-:8080}"

start() {
    echo "Starting NAS file browser (root=$NAS_ROOT)..."
    # 等待 U 盘挂载完成
    sleep 3
    start-stop-daemon -S -b -m -p /var/run/nas-web.pid -x "$NAS_BIN" -- \
        -root "$NAS_ROOT" -addr "$NAS_ADDR"
}

stop() {
    echo "Stopping NAS file browser..."
    start-stop-daemon -K -p /var/run/nas-web.pid -x "$NAS_BIN" 2>/dev/null || true
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    *)       echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
